    {
      "id": "intro",
      "text": "أَنَا مُدَرِّبَةُ الرَّوْضَةِ. سَنُشَاهِدُ وَنَرْسُمُ خُطْوَةً خُطْوَةً.",
      "language": "ar"
    },
    {
      "id": "watch",
      "text": "شَاهِدْ حَرَكَةَ الْقَلَمِ. ثُمَّ جَرِّبْ بِإِصْبَعِكَ أَوْ بِالْقَلَمِ.",
      "language": "ar"
    },
    {
      "id": "turn",
      "text": "الْآنَ دَوْرُكَ. اِبْدَأْ مِنَ النُّقْطَةِ وَاتَّبِعِ الْمَسَارَ.",
      "language": "ar"
    },
    {
      "id": "continue",
      "text": "مُحَاوَلَةٌ جَمِيلَةٌ. أَكْمِلِ الْجُزْءَ الْبَاقِيَ بِهُدُوءٍ.",
      "language": "ar"
    },
    {
      "id": "help",
      "text": "لِنُجَرِّبْ مَعًا. شَاهِدْ هَذَا الْجُزْءَ، ثُمَّ ارْسُمْهُ بِنَفْسِكَ.",
      "language": "ar"
    },
    {
      "id": "retry",
      "text": "لَا بَأْسَ. نَبْدَأُ مِنَ النُّقْطَةِ وَنَقْتَرِبُ مِنَ الْخَطِّ.",
      "language": "ar"
    },
    {
      "id": "step",
      "text": "أَكْمَلْتَ هَذَا الْجُزْءَ. نَنْتَقِلُ إِلَى الْجُزْءِ التَّالِي.",
      "language": "ar"
    },
    {
      "id": "independent",
      "text": "رَائِعٌ. جَرِّبِ الْآنَ رَسْمَ الشَّكْلِ كَامِلًا دُونَ حَرَكَةِ الْيَدِ، بِهُدُوءٍ.",
