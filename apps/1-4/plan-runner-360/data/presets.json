    {
      "id": "2-3",
      "label_ar": "2–3 سنوات",
      "guidance_ar": "ثلاث خطوات قصيرة متنوعة مع اختيار بسيط وتبادل دور وانتقال متوقع."
    },
    {
      "id": "3-4",
      "label_ar": "3–4 سنوات",
      "guidance_ar": "ثلاث إلى أربع خطوات مع مساحة اختيار أكبر ومزج بين اللغة والحركة والرسم والعادات."
