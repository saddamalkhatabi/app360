{
  "schema_version": 1,
  "app_id": "mini-golf",
  "age_groups": ["1-4", "4-8"],
  "levels": {"1-4": [1, 2, 5, 6, 7, 8], "4-8": [3, 4, 9, 10, 11, 12]},
  "activation": "coachBtn or three consecutive play putts without measurable progress, or six putts without a capture since the last help",
  "automatic_help": {"enabled_by_default": true, "opt_out": "autoCoachCheck", "respects_mute": true},
