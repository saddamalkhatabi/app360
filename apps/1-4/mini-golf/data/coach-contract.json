  "demonstration": {"isolated_from_play": true, "counts_as_child_attempt": false, "restores_original_round": true},
  "practice": {"real_child_action_required": true, "independent_retry": true, "pause_preserves_child_attempt": true},
  "measurement": {"storage": "local per identity, entry age and level", "play_and_practice_separate": true, "comparison_window": [5, 5], "automatic_mastery": false, "claims_causal_impact": false},
  "audio": {"engine": "SILMA 1.0.5", "languages": ["ar", "en"], "runtime_generation": false, "missing_audio": "visible transcript, replay and hand remain available"},
  "lifecycle": ["stop on identity change", "stop on hidden page", "stop on level change", "stop on settings", "cancel stale audio and timers"],
  "api": "window.MiniGolfCoach"
}
