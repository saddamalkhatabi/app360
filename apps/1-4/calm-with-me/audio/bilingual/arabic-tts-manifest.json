      "text_en": "",
      "english_path": "audio/bilingual/en/phrases/1592200c5b92c94b.mp3",
      "sources": [
        "situation:bath"
      ]
    },
    {
      "key": "ceb1ebb735eb31a2",
      "language": "ar",
      "engine": "silma",
      "text": "لن نجبرك. سنجرب خطوة صغيرة عندما تكون جاهزًا.",
