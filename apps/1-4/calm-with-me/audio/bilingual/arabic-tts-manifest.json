    {
      "key": "60bbdd3038c47957",
      "language": "ar",
      "engine": "silma",
      "text": "أفهم أن فكرة الحرامي أخافتك. نحن آمنون الآن وأنا معك.",
      "path": "audio/bilingual/ar/phrases/60bbdd3038c47957.mp3",
