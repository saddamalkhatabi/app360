      "text_en": "",
      "english_path": "audio/bilingual/en/phrases/34d35b0fad57106b.mp3",
      "sources": [
        "situation:loud-sound"
      ]
    },
    {
      "key": "c18f1cb27cc61cdf",
      "language": "ar",
      "engine": "silma",
      "text": "الكلب بعيد ونحن هنا. يمكنك أن تشاهده من مكاني أو نبتعد.",
