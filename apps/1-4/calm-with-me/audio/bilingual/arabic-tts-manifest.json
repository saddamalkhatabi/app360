      "text_en": "",
      "english_path": "audio/bilingual/en/phrases/c18f1cb27cc61cdf.mp3",
      "sources": [
        "situation:dog"
      ]
    },
    {
      "key": "f4c01bb3c8fe0c8b",
      "language": "ar",
      "engine": "silma",
      "text": "سأبقى معك. سأخبرك بما سيحدث خطوة خطوة.",
