      "english_path": "audio/bilingual/en/phrases/d358477db249e2c6.mp3",
      "sources": [
        "situation:daycare-drop"
      ]
    },
    {
      "key": "8c96b7cca06dec94",
      "language": "ar",
      "engine": "silma",
      "text": "أنت مشتاق له. يمكننا أن ننظر إلى الصورة ونكمل يومنا حتى يعود.",
