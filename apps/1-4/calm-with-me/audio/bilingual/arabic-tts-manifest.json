      "text_en": "",
      "english_path": "audio/bilingual/en/phrases/f4c01bb3c8fe0c8b.mp3",
      "sources": [
        "situation:doctor"
      ]
    },
    {
      "key": "1592200c5b92c94b",
      "language": "ar",
      "engine": "silma",
      "text": "سنغسل جزءًا صغيرًا ثم نتوقف لنرى كيف أنت.",
