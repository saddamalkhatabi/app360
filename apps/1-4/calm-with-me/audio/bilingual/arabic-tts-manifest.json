      "english_path": "audio/bilingual/en/phrases/05e50b699454a5e5.mp3",
      "sources": [
        "situation:dark"
      ]
    },
    {
      "key": "af2e96bf1c8ff8dd",
      "language": "ar",
      "engine": "silma",
      "text": "أعرف أن الفكرة مخيفة. الوحش في الخيال، ونحن الآن في غرفتنا الآمنة.",
      "path": "audio/bilingual/ar/phrases/af2e96bf1c8ff8dd.mp3",
      "text_en": "",
      "english_path": "audio/bilingual/en/phrases/af2e96bf1c8ff8dd.mp3",
      "sources": [
        "situation:monster"
      ]
    },
    {
      "key": "34d35b0fad57106b",
      "language": "ar",
      "engine": "silma",
      "text": "الصوت قوي. يمكننا أن نبتعد قليلًا.",
