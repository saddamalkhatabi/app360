      "english_path": "audio/bilingual/en/phrases/8eb04ef12fdc94a7.mp3",
      "sources": [
        "situation:no-item"
      ]
    },
    {
      "key": "65dad83d4d125c26",
      "language": "ar",
      "engine": "silma",
