      ]
    },
    {
      "key": "05e50b699454a5e5",
      "language": "ar",
      "engine": "silma",
      "text": "الظل شكله غريب لكنه من الضوء والأشياء. أنا هنا والبيت آمن.",
      "path": "audio/bilingual/ar/phrases/05e50b699454a5e5.mp3",
