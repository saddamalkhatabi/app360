{
  "schema_version": "1.1",
  "app_id": "a1-first-words",
  "title_ar": "كلماتي مع أشيائي: اسمع وأشر وسمِّ",
  "base_path": "apps/1-4/say-and-name/",
  "app_href": "apps/1-4/say-and-name/index.html",
  "launch_path": "apps/1-4/say-and-name/launch.html",
  "domain_policy": "relative-only",
  "events": "app360:interop:v1:events",
  "routes": [
    {
      "id": "library",
      "kind": "service",
      "label_ar": "مكتبة الكلمات كاملة",
      "href": "apps/1-4/say-and-name/launch.html?action=library"
    },
    {
      "id": "category",
      "kind": "category",
      "label_ar": "تصنيف كلمات",
      "href_template": "apps/1-4/say-and-name/launch.html?action=category&category={category}&level={level}",
      "params": [
        "category",
        "level",
        "display"
      ],
      "collection_source": "data/levels-inline-v8.js",
      "collection_kind": "word-categories"
    },
    {
      "id": "word",
      "kind": "item",
      "label_ar": "بطاقة كلمة محددة",
      "href_template": "apps/1-4/say-and-name/launch.html?action=word&word={word}&level={level}",
      "params": [
        "word",
        "level",
        "display"
      ],
      "collection_source": "data/levels-inline-v8.js",
      "collection_kind": "words",
      "completion_ar": "يسجل التنفيذ عند استخدام زر النطق أو الضغط على الصورة الرئيسية."
    },
    {
      "id": "random",
      "kind": "service",
      "label_ar": "مراجعة عشوائية",
      "href": "apps/1-4/say-and-name/launch.html?action=random"
    },
    {
      "id": "names-category",
      "kind": "service",
      "label_ar": "مدربة الروضة · أسماء مجموعة",
      "href": "apps/1-4/say-and-name/launch.html?action=session&route=names-category",
      "params": [
        "level",
        "category",
        "duration_seconds",
        "response_seconds",
        "autoplay",
        "caller",
        "launch_id"
      ],
      "completion_ar": "انتهاء الوقت أو المسار لا يسجّل إنجازًا؛ يلزم تأكيد التنفيذ من المستخدم."
    },
    {
      "id": "names-review",
      "kind": "service",
      "label_ar": "مدربة الروضة · مراجعة كلمات",
      "href": "apps/1-4/say-and-name/launch.html?action=session&route=names-review",
      "params": [
        "level",
        "category",
        "duration_seconds",
        "response_seconds",
        "autoplay",
        "caller",
        "launch_id"
      ],
      "completion_ar": "انتهاء الوقت أو المسار لا يسجّل إنجازًا؛ يلزم تأكيد التنفيذ من المستخدم."
    },
    {
      "id": "sentences-category",
      "kind": "service",
      "label_ar": "مدربة المدرسة · جمل مجموعة",
      "href": "apps/1-4/say-and-name/launch.html?action=session&route=sentences-category",
      "params": [
        "level",
        "category",
        "duration_seconds",
        "response_seconds",
        "autoplay",
        "caller",
        "launch_id"
      ],
      "completion_ar": "انتهاء الوقت أو المسار لا يسجّل إنجازًا؛ يلزم تأكيد التنفيذ من المستخدم."
    },
    {
      "id": "sentences-review",
      "kind": "service",
      "label_ar": "مدربة المدرسة · مراجعة جمل",
      "href": "apps/1-4/say-and-name/launch.html?action=session&route=sentences-review",
      "params": [
        "level",
        "category",
        "duration_seconds",
        "response_seconds",
        "autoplay",
        "caller",
        "launch_id"
      ],
      "completion_ar": "انتهاء الوقت أو المسار لا يسجّل إنجازًا؛ يلزم تأكيد التنفيذ من المستخدم."
    }
  ],
  "interop_params": [
    "caller",
    "launch_id",
    "return_to",
    "embedded"
  ],
  "note_ar": "التطبيق والتصنيفات والكلمات والخدمات قابلة للاستدعاء بروابط مباشرة. الروابط الداخلية نسبية ولا تحتوي اسم نطاق ثابت."
}
