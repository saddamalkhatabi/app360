{"schema_version":1,"timing_source":"Actual recording WordBoundary; punctuation tokens have no fabricated cue","items":{"audio/en/agree.mp3":{"text":"Do we all agree? We can suggest a change.","language":"en","duration":4872,"cues":[[0,106,244],[1,258,439],[2,453,661],[3,675,1189],[4,2153,2333],[5,2347,2542],[6,2556,3056],[7,3069,3125],[8,3139,3861]]},"audio/en/help.mp3":{"text":"Let us ask our grown-up for help and say what we need.","language":"en","duration":4032,"cues":[[0,106,342],[1,356,508],[2,522,800],[3,814,939],[4,953,1342],[5,1356,1522],[6,1536,1897],[7,1911,2064],[8,2078,2258],[9,2272,2425],[10,2439,2564],[11,2578,3022]]},"audio/en/intro.mp3":{"text":"We both want the truck. Let us listen and try a plan.","language":"en","duration":5448,"cues":[[0,106,272],[1,286,592],[2,606,842],[3,856,939],[4,953,1522],[5,2486,2722],[6,2736,2903],[7,2917,3389],[8,3403,3500],[9,3514,3764],[10,3778,3847],[11,3861,4444]]},"audio/en/needA.mp3":{"text":"I would like to play with the truck. May I have a turn?","language":"en","duration":4896,"cues":[[0,106,244],[1,258,439],[2,453,647],[3,661,758],[4,772,1022],[5,1036,1189],[6,1203,1314],[7,1328,1883],[8,2847,3042],[9,3056,3139],[10,3153,3319],[11,3333,3417],[12,3431,3889]]},"audio/en/needB.mp3":{"text":"I would like a turn too. Let us find a plan that works for us.","language":"en","duration":5712,"cues":[[0,106,244],[1,258,425],[2,439,633],[3,647,717],[4,731,1008],[5,1022,1494],[6,2458,2694],[7,2708,2847],[8,2861,3111],[9,3125,3181],[10,3194,3542],[11,3556,3722],[12,3736,4042],[13,4056,4236],[14,4250,4694]]},"audio/en/pause.mp3":{"text":"Let us take a break. We can return when we are ready.","language":"en","duration":5184,"cues":[[0,106,342],[1,356,508],[2,522,744],[3,758,828],[4,842,1397],[5,2361,2542],[6,2556,2722],[7,2736,3208],[8,3222,3375],[9,3389,3528],[10,3542,3681],[11,3694,4181]]},"audio/en/review.mp3":{"text":"What happened? Shall we keep our plan or change it?","language":"en","duration":5016,"cues":[[0,106,328],[1,342,994],[2,1958,2194],[3,2208,2333],[4,2347,2583],[5,2597,2736],[6,2750,3153],[7,3167,3292],[8,3306,3681],[9,3694,4000]]},"audio/en/saved.mp3":{"text":"Our plan is saved. We can come back to it.","language":"en","duration":4728,"cues":[[0,106,286],[1,300,647],[2,661,800],[3,814,1356],[4,2319,2500],[5,2514,2694],[6,2708,2917],[7,2931,3208],[8,3222,3389],[9,3403,3708]]},"audio/en/solutions.mp3":{"text":"Let us look at two plans. Which one would we like to try?","language":"en","duration":5352,"cues":[[0,106,342],[1,356,494],[2,508,675],[3,689,800],[4,814,981],[5,994,1731],[6,2694,2972],[7,2986,3139],[8,3153,3278],[9,3292,3417],[10,3431,3681],[11,3694,3792],[12,3806,4333]]},"audio/en/together.mp3":{"text":"We play together. I build the road and you drive the truck.","language":"en","duration":5448,"cues":[[0,106,286],[1,300,550],[2,564,1272],[3,2236,2389],[4,2403,2639],[5,2653,2750],[6,2764,3153],[7,3167,3347],[8,3361,3472],[9,3486,3764],[10,3778,3861],[11,3875,4431]]},"audio/en/trial.mp3":{"text":"Now let us try our plan with a toy or puppets.","language":"en","duration":3888,"cues":[[0,106,356],[1,369,564],[2,578,703],[3,717,967],[4,981,1106],[5,1119,1467],[6,1481,1633],[7,1647,1703],[8,1717,1994],[9,2008,2133],[10,2147,2869]]},"audio/en/turns.mp3":{"text":"We take turns. I play, then pass the truck to you.","language":"en","duration":5688,"cues":[[0,106,286],[1,300,606],[2,619,1300],[3,2264,2431],[4,2444,2903],[5,3111,3333],[6,3347,3681],[7,3694,3792],[8,3806,4125],[9,4139,4250],[10,4264,4667]]}}}
