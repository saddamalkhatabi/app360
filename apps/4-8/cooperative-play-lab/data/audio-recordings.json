    {
      "path": "audio/intro.mp3",
      "text": "نَشَاهِدُ مَوْقِفًا، وَنَسْمَعُ حَاجَةَ كُلِّ شَخْصٍ، ثُمَّ نَخْتَارُ حَلًّا وَنُجَرِّبُهُ. لَكَ حَقُّ الْمُسَاعَدَةِ وَالِاسْتِرَاحَةِ.",
      "language": "ar",
      "engine": "silma",
