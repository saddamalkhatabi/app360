    },
    {
      "path": "audio/help.mp3",
      "text": "هَذَا مَكَانُ الْمُرَافِقِ. اسْمَعْ حَاجَةَ كُلِّ طَرَفٍ وَاعْرِضْ خِيَارَيْنِ. لَا تَفْرِضْ مُوَافَقَةً، وَاحْتَرِمِ الرَّفْضَ وَالِاسْتِرَاحَةَ.",
      "language": "ar",
      "engine": "silma",
      "kind": "guide",
