  "items": [
    {
      "path": "audio/same-toy-0.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "يَلْعَبُ سَامِي بِالسَّيَّارَةِ الْحَمْرَاءِ، وَتُرِيدُهَا لَيَانُ أَيْضًا. هَلْ نَجِدُ حَلًّا دُونَ سَحْبِ اللُّعْبَةِ؟",
      "kind": "scene",
      "bytes": 49440,
      "sha256": "367625f9b55013381122a61e852c5a8af8d9d37871d0600a153bfa52dbb8897e",
      "duration_ms": 8208,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-1.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "تَقُولُ لَيَانُ: أُرِيدُ أَنْ أَلْعَبَ. وَيَقُولُ سَامِي: أُرِيدُ إِكْمَالَ الْمِرْآبِ. لِنَسْمَعِ الْحَاجَتَيْنِ.",
      "kind": "scene",
      "bytes": 46848,
      "sha256": "a2b944f983c2c929b2b41513d242fc41eb484c9360d80a850d8940dd2c82bbc9",
      "duration_ms": 7776,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-2.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "اسْأَلْ بِهُدُوءٍ: هَلْ يَأْتِي دَوْرِي عِنْدَمَا تَنْتَهِي؟ اخْتَرِ الْحَاجَةَ الَّتِي تُرِيدُ تَمْثِيلَهَا.",
      "kind": "scene",
      "bytes": 44688,
      "sha256": "47911baddc6b04538f6a1e907718ebc2331cccd00134abbddfec7fba0197bcfb",
      "duration_ms": 7416,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-3.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "نُحَدِّدُ نِهَايَةَ الدَّوْرِ، أَوْ نَلْعَبُ بِسَيَّارَتَيْنِ. اخْتَرَا حَلًّا يُنَاسِبُكُمَا. يُمْكِنُ طَلَبُ بَدِيلٍ أَوْ مُسَاعَدَةٍ.",
      "kind": "scene",
      "bytes": 63408,
      "sha256": "aa9898ef641b7cdeb2c96e00d57d38ccc8e736c3f4f58d5669ccab2a8a08727f",
      "duration_ms": 10536,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-5.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "جَرِّبَا الِاتِّفَاقَ بِلُعْبَةٍ أَوْ دُمْيَتَيْنِ. يَحِقُّ لَكُمَا طَلَبُ اسْتِرَاحَةٍ. اضْغَطَا جَرَّبْنَا بَعْدَ الْمُحَاوَلَةِ فَقَطْ.",
      "kind": "scene",
      "bytes": 62832,
      "sha256": "284d3d6e424f6e6a83a65d3fc19d7fad058e07ed699795816b63a4de291d5289",
      "duration_ms": 10440,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-6.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "هَلْ أَرَاحَكُمَا الِاتِّفَاقُ؟ إِنْ نَاسَبَكُمَا نَحْفَظُهُ، وَإِلَّا نُعَدِّلُهُ. الْمُهِمُّ أَنْ نَسْمَعَ بَعْضَنَا.",
      "kind": "scene",
      "bytes": 49440,
      "sha256": "c135d152e3d908207e8c7fb5efdd248259554aaed20ecd6f2204da086badb037",
      "duration_ms": 8208,
      "precision": "fp32",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-solution-0.mp3",
      "text": "نَتَّفِقُ عَلَى نِهَايَةِ الدَّوْرِ. عِنْدَمَا تَدْخُلُ السَّيَّارَةُ الْمِرْآبَ، يَعْرِضُ سَامِي الدَّوْرَ عَلَى لَيَانَ. لَا نَنْتَزِعُ اللُّعْبَةَ.",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 64704,
      "sha256": "212040024458e2265516f813e9997e49c7bdb839bd69e9e2caca933ca98bfdf9",
      "duration_ms": 10752,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/same-toy-solution-1.mp3",
      "text": "يَخْتَارُ كُلُّ طِفْلٍ سَيَّارَةً وَطَرِيقًا. نَلْعَبُ مَعًا بِدُونِ تَبْدِيلٍ إِجْبَارِيٍّ. وَإِنْ لَمْ نَرْتَحْ نُعَدِّلُ الْحَلَّ.",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 60816,
      "sha256": "e3613f9a2a3ab4464cf706c064595131fa1464f56fadf0994754c7a5b81d58f1",
      "duration_ms": 10104,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-0.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "تُرِيدُ هَنَا إِبْعَادَ السَّلَّةِ، وَيُفَضِّلُ عُمَرُ قُرْبَهَا. هَلْ نُغَيِّرُ الْقَاعِدَةَ مِنْ غَيْرِ اتِّفَاقٍ؟",
      "kind": "scene",
      "bytes": 47712,
      "sha256": "dbe5c37962deac9db8a2d65135b71f9edc62955e24a5948b969963934ee6e7f1",
      "duration_ms": 7920,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-1.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "تُرِيدُ هَنَا تَحَدِّيًا جَدِيدًا. وَيُرِيدُ عُمَرُ دَوْرًا يُنَاسِبُهُ. نَسْمَعُ كُلَّ طَرَفٍ قَبْلَ اخْتِيَارِ الْحَلِّ.",
      "kind": "scene",
      "bytes": 56496,
      "sha256": "cc4eb927eba70e9f84e33f7e7d305fdec2257d428a5f0748b419e13d84f0f914",
      "duration_ms": 9384,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-2.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "نَقُولُ: مَا رَأْيُكَ أَنْ نُجَرِّبَ؟ ثُمَّ نَنْتَظِرُ الْجَوَابَ. يَحِقُّ لِصَدِيقِنَا الرَّفْضُ أَوِ اقْتِرَاحُ بَدِيلٍ.",
      "kind": "scene",
      "bytes": 57792,
      "sha256": "ee8450e2b1642109f4ecf959ee1029626f2c94c55435e48b0cfb206728bf81cf",
      "duration_ms": 9600,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-3.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "نُجَرِّبُ جَوْلَةً ثُمَّ نُرَاجِعُهَا، أَوْ يَخْتَارُ كُلُّ لَاعِبٍ مَسَافَةً تُنَاسِبُهُ. أَيُّ الْحَلَّيْنِ تُرِيدَانِ تَجْرِبَتَهُ؟",
      "kind": "scene",
      "bytes": 60528,
      "sha256": "ba20bf2f08986f6b32364c165e03ba80683a978d0d6f13b88b218ed760cb449b",
      "duration_ms": 10056,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-5.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "جَرِّبَا بِكُرَةٍ لَيِّنَةٍ فِي مَكَانٍ آمِنٍ مَعَ الْمُرَافِقِ، أَوْ مَثِّلَا الْمَوْقِفَ بِالدُّمَى. نَتَعَلَّمُ دُونَ مُقَارَنَةٍ.",
      "kind": "scene",
      "bytes": 62688,
      "sha256": "6aaa841c46a7aa7ec70a1ade0d453ef3b9eb35faa1f88d9dd3ac20c2d54a1c13",
      "duration_ms": 10416,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-6.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "هَلْ شَارَكَ كُلٌّ مِنْكُمَا بِرَاحَةٍ؟ إِنْ كَانَتِ الْقَاعِدَةُ مُتْعِبَةً، نُقَرِّبُ السَّلَّةَ أَوْ نُعَدِّلُ الِاتِّفَاقَ.",
      "kind": "scene",
      "bytes": 55344,
      "sha256": "d5166b5086b67f1c5c78a1275a5cecc71c3a5473aeb0d657fae741fa15348ece",
      "duration_ms": 9192,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-solution-0.mp3",
      "text": "نُجَرِّبُ جَوْلَةً قَصِيرَةً بِمُوَافَقَةِ اللَّاعِبَيْنِ. ثُمَّ نُقَرِّرُ: هَلْ نُكْمِلُ، أَمْ نُغَيِّرُ الْمَسَافَةَ، أَمْ نَعُودُ لِلْقَاعِدَةِ الْأُولَى؟",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 66144,
      "sha256": "f0d470429a4627fd730f780a5454f23d4a0a2ffaf6424c01b7db7e161da53a38",
      "duration_ms": 10992,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/change-rule-solution-1.mp3",
      "text": "يَخْتَارُ كُلُّ لَاعِبٍ مَسَافَةً تُنَاسِبُهُ. قَدْ نَخْتَلِفُ فِي الطَّرِيقَةِ، وَنَحْتَرِمُ الدَّوْرَ، وَنَسْتَمْتِعُ بِاللَّعِبِ مَعًا.",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 61680,
      "sha256": "dc7149fd7b97b05c15fc531d30050519f93438865c81e81601e0189049624a2e",
      "duration_ms": 10248,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-0.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "يَبْنِي آدَمُ وَرِيمٌ جِسْرًا، وَيُرِيدُ زَيْدٌ الِانْضِمَامَ. كَيْفَ نَجِدُ دَوْرًا مُفِيدًا وَنَحْتَرِمُ مَا بَنَاهُ أَصْحَابُنَا؟",
      "kind": "scene",
      "bytes": 59520,
      "sha256": "6e2edf4ec71854189f7f5092e94f2a5aa8a95284801e634f835c635e7e270033",
      "duration_ms": 9888,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-1.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "يُرِيدُ زَيْدٌ أَنْ يَلْعَبَ مَعَهُمَا. وَيُرِيدُ آدَمُ وَرِيمٌ إِكْمَالَ الْجِسْرِ. لَدَيْنَا حَاجَةُ الِانْضِمَامِ وَحَاجَةُ إِكْمَالِ الْعَمَلِ.",
      "kind": "scene",
      "bytes": 64704,
      "sha256": "7a0566e2eedcf0e692f7283c2e6d39185f577a1e4e30743d002e7e9341d69c3a",
      "duration_ms": 10752,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-2.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "اسْأَلْ: مَا الدَّوْرُ الَّذِي أُشَارِكُ بِهِ؟ لَا نَهْدِمُ عَمَلَ غَيْرِنَا، وَلَا نَفْرِضُ دَوْرًا لَا يَرْتَاحُ لَهُ.",
      "kind": "scene",
      "bytes": 49584,
      "sha256": "1b2b815e43acffce5948cf33e63d7e16cbfd5a7403c8821244745d31f0a59db4",
      "duration_ms": 8232,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-3.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "يُمْكِنُ لِزَيْدٍ بِنَاءُ الطَّرِيقِ، أَوِ الْمُشَارَكَةُ فِي بِنَاءِ الْجِسْرِ. وَيُمْكِنُ اقْتِرَاحُ دَوْرٍ آخَرَ. أَيُّ اتِّفَاقٍ تُرِيدُونَ تَجْرِبَتَهُ؟",
      "kind": "scene",
      "bytes": 67584,
      "sha256": "d9b2bc472e6cbcaef079507ca1cc75ee2fb029a90723f17b3e51f3535dab3e4c",
      "duration_ms": 11232,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-5.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "مَثِّلُوا الْأَدْوَارَ بِمُكَعَّبَاتٍ كَبِيرَةٍ أَوْ دُمْيَاتٍ. هَلْ دَوْرُ كُلِّ لَاعِبٍ وَاضِحٌ؟ يُمْكِنُ طَلَبُ تَبْدِيلٍ أَوِ اسْتِرَاحَةٍ.",
      "kind": "scene",
      "bytes": 64848,
      "sha256": "9b640af176c760a2953dc1b373aca5e9ca7bcc9a6c701b6ab3eeb218b1cec64a",
      "duration_ms": 10776,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-6.mp3",
      "language": "ar",
      "engine": "silma",
      "text": "هَلْ وَجَدَ كُلُّ لَاعِبٍ دَوْرًا مُفِيدًا؟ إِنْ لَمْ يَرْتَحْ أَحَدٌ، نَسْمَعُهُ وَنُعَدِّلُ الدَّوْرَ، أَوْ نَخْتَارُ نَشَاطًا آخَرَ.",
      "kind": "scene",
      "bytes": 59952,
      "sha256": "c087182a95074ce28c30dd25b6a80d4f3de829277cb7ab1887d259c201415bab",
      "duration_ms": 9960,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-solution-0.mp3",
      "text": "يَخْتَارُ زَيْدٌ بِنَاءَ الطَّرِيقِ. نُرِيهِ أَيْنَ يَتَّصِلُ بِالْجِسْرِ، وَنَتْرُكُ لَهُ عَمَلًا حَقِيقِيًّا. نَسْأَلُهُ إِنْ كَانَ يُنَاسِبُهُ.",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 66288,
      "sha256": "b0140b03ce4df4c49bcd21b4be8fc113bd0937228083f8dbfedd108d0823483b",
      "duration_ms": 11016,
      "precision": "bf16",
      "engine_version": "silma-tts-1.0.5",
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5"
    },
    {
      "path": "audio/new-player-solution-1.mp3",
      "text": "يُضِيفُ زَيْدٌ قِطْعَةً إِلَى الْجِسْرِ، وَيَبْنِي صَدِيقَاهُ الطَّرِيقَ وَيَخْتَبِرَانِ الْمُرُورَ. يُمْكِنُ تَبَادُلُ الْأَدْوَارِ بِرِضَا الْجَمِيعِ.",
      "language": "ar",
      "engine": "silma",
      "kind": "agreement",
      "bytes": 64848,
