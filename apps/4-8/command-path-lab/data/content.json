{
  "schema_version": 1,
  "coordinate_frame": "screen-fixed; x right, y down; robot direction 0 north, 1 east, 2 south, 3 west; never mirrored by RTL",
  "levels": [
    {
      "id": 1,
      "title": {
        "ar": "أرتب الطريق",
        "en": "Arrange the route"
      },
      "age": "4–5"
    },
    {
      "id": 2,
      "title": {
        "ar": "أدور وأصحح",
        "en": "Turn and debug"
      },
      "age": "5–6"
    },
    {
      "id": 3,
      "title": {
        "ar": "أكرر وأبتكر",
        "en": "Repeat and invent"
      },
      "age": "6–8"
    }
  ],
  "phrases": {
    "library": {
      "ar": "اخْتَرْ خَرِيطَةً، ثُمَّ سَاعِدِ الرُّوبُوتَ عَلَى الْوُصُولِ.",
      "en": "Choose a map, then help the robot reach its destination."
    },
    "predict": {
      "ar": "كَيْفَ سَيَسِيرُ الرُّوبُوتُ؟ الْمَسِ الْمُرَبَّعَ التَّالِي لِتَرْسُمَ تَوَقُّعَكَ.",
      "en": "How will the robot travel? Touch the next square to draw your prediction."
    },
    "plan": {
      "ar": "الْمَسِ الْأَوَامِرَ لِتَرْتِيبِ الطَّرِيقِ. ثُمَّ شَغِّلْ خُطْوَةً وَشَاهِدْ.",
      "en": "Touch commands to build the route. Then run a step and watch."
    },
    "n": {
      "ar": "إِلَى أَعْلَى الْخَرِيطَةِ.",
      "en": "Move up the map."
    },
    "e": {
      "ar": "إِلَى يَمِينِ الْخَرِيطَةِ.",
      "en": "Move right on the map."
    },
    "s": {
      "ar": "إِلَى أَسْفَلِ الْخَرِيطَةِ.",
      "en": "Move down the map."
    },
    "w": {
      "ar": "إِلَى يَسَارِ الْخَرِيطَةِ.",
      "en": "Move left on the map."
    },
    "f": {
      "ar": "تَقَدَّمْ إِلَى الْمُرَبَّعِ التَّالِي أَمَامَ الرُّوبُوتِ.",
      "en": "Move to the next square in front of the robot."
    },
    "l": {
      "ar": "دُرْ إِلَى يَسَارِكَ فِي مَكَانِكَ.",
      "en": "Turn left in place."
    },
    "r": {
      "ar": "دُرْ إِلَى يَمِينِكَ فِي مَكَانِكَ.",
      "en": "Turn right in place."
    },
    "repeat": {
      "ar": "كَرِّرْ هَذِهِ الْمَجْمُوعَةَ مِنَ الْأَوَامِرِ.",
      "en": "Repeat this group of commands."
    },
    "if": {
      "ar": "إِذَا كَانَ أَمَامَكَ حَاجِزٌ أَوْ حَافَّةٌ، دُرْ يَمِينًا. وَإِلَّا، تَقَدَّمْ.",
      "en": "If there is a barrier or edge ahead, turn right. Otherwise, move forward."
    },
    "blocked": {
      "ar": "تَوَقَّفْنَا عِنْدَ حَاجِزٍ أَوْ حَافَّةٍ. أَيُّ أَمْرٍ نُغَيِّرُ؟",
      "en": "We stopped at a barrier or edge. Which command could we change?"
    },
    "arrived": {
      "ar": "وَصَلْنَا. شَاهِدْ طَرِيقَكَ، ثُمَّ احْفَظْهُ إِنْ شِئْتَ.",
      "en": "We arrived. Look at your route, then save it if you wish."
    },
    "away": {
      "ar": "انْتَهَتِ الْأَوَامِرُ هُنَا. هَلْ نُضِيفُ أَمْرًا أَمْ نُغَيِّرُ أَمْرًا؟",
      "en": "The commands ended here. Could we add a command or change one?"
    },
    "step": {
      "ar": "نُجَرِّبُ أَمْرًا وَاحِدًا، ثُمَّ نَتَوَقَّفُ لِنَرَى.",
      "en": "Try one command, then stop and look."
    },
    "paused": {
      "ar": "تَوَقَّفْنَا. يَبْقَى طَرِيقُكَ مَحْفُوظًا لِتُكْمِلَ.",
      "en": "We paused. Your route stays here so you can continue."
    },
    "saved": {
      "ar": "حَفِظْنَا طَرِيقَكَ. يُمْكِنُكَ فَتْحُ نُسْخَةٍ وَتَجْرِبَةُ فِكْرَةٍ أُخْرَى.",
      "en": "We saved your route. Open a copy to try another idea."
    },
    "hint": {
      "ar": "شَاهِدْ أَوَّلَ مُرَبَّعٍ لَمْ يَسِرْ كَمَا تَوَقَّعْتَ. عَدِّلْ أَمْرًا وَجَرِّبْ.",
      "en": "Look at the first square that differed from your prediction. Change a command and try again."
    },
    "predictSkip": {
      "ar": "يُمْكِنُكَ أَنْ تَتَوَقَّعَ أَوْ تَكْتَشِفَ بِالْمُشَاهَدَةِ.",
      "en": "You can predict first or discover by watching."
    },
    "designer": {
      "ar": "اخْتَرِ الْبِدَايَةَ أَوِ الْمَقْصِدَ أَوِ الْحَاجِزَ، ثُمَّ الْمَسِ الْمُرَبَّعَ.",
      "en": "Choose start, destination or barrier, then touch a square."
    },
    "start": {
      "ar": "اخْتَرْ مُرَبَّعَ الْبِدَايَةِ.",
      "en": "Choose the starting square."
    },
    "goal": {
      "ar": "اخْتَرْ مُرَبَّعَ الْمَقْصِدِ.",
      "en": "Choose the destination square."
    },
    "wall": {
      "ar": "ضَعْ حَاجِزًا فِي مُرَبَّعٍ فَارِغٍ.",
      "en": "Place a barrier in an empty square."
    },
    "erase": {
      "ar": "الْمَسْ حَاجِزًا لِتُزِيلَهُ.",
      "en": "Touch a barrier to remove it."
    },
    "demo": {
      "ar": "شَاهِدْ هَذَا الْمِثَالَ. نُرَتِّبُ الْأَوَامِرَ ثُمَّ نُجَرِّبُ خُطْوَةً خُطْوَةً.",
      "en": "Watch this separate example. Arrange the commands, then try them one step at a time."
    },
    "rotation": {
      "ar": "مُقَدِّمَةُ الرُّوبُوتِ تَدُلُّ عَلَى اتِّجَاهِهِ. الدَّوَرَانُ يُغَيِّرُ اتِّجَاهَهُ دُونَ أَنْ يَنْتَقِلَ.",
      "en": "The robot points in its facing direction. Turning changes its direction without changing its square."
    },
    "real": {
      "ar": "ضَعْ بَطَاقَاتِ الْأَوَامِرِ عَلَى طَاوِلَةٍ أَوْ فِي مَسَاحَةٍ آمِنَةٍ مَعَ الْمُرَبِّي.",
      "en": "Use command cards on a table or in a safe space with your coach."
    },
    "goal-book": {
      "ar": "الْمَقْصِدُ فِي هَذِهِ الْخَرِيطَةِ: كِتَاب.",
      "en": "Our destination on this map is the book."
    },
    "goal-ball": {
      "ar": "الْمَقْصِدُ فِي هَذِهِ الْخَرِيطَةِ: كُرَة.",
      "en": "Our destination on this map is the ball."
    },
    "goal-apple": {
      "ar": "الْمَقْصِدُ فِي هَذِهِ الْخَرِيطَةِ: تُفَّاح.",
      "en": "Our destination on this map is the apple."
    },
    "goal-bear": {
      "ar": "الْمَقْصِدُ فِي هَذِهِ الْخَرِيطَةِ: دُبّ.",
      "en": "Our destination on this map is the bear."
    },
    "goal-cat": {
      "ar": "الْمَقْصِدُ فِي هَذِهِ الْخَرِيطَةِ: قِطَّة.",
