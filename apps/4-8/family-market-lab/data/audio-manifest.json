    {
      "path": "audio/ar-guide-library.mp3",
      "text": "اِخْتَرْ تَجْرِبَةً وَالْعَبْ. فِي كُلِّ مَرَّةٍ طَلَبٌ جَدِيدٌ وَصُوَرٌ مُخْتَلِفَةٌ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "54caa96a3dd37602992974e4d79d7e1c7757a081b8d386f74ae4e6e44cbe5474"
    },
    {
      "path": "audio/ar-guide-count.mp3",
      "text": "اِضْغَطْ عَلَى الصُّورَةِ لِتَضَعَ بَطَاقَةً فِي السَّلَّةِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "6e906e786931b5f2d522089e24f94b1a300be14b3f1e34a72bc1039bc5906c8e"
    },
    {
      "path": "audio/ar-guide-share.mp3",
      "text": "اِخْتَرْ سَلَّةً، ثُمَّ اضْغَطْ عَلَى الصُّورَةِ. وَزِّعْ كُلَّ الْبَطَاقَاتِ بِالتَّسَاوِي.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "bf24740d4436d88173af9d78158fe5d274bdfbe0bc8dea203b4e3fbe3525da12"
    },
    {
      "path": "audio/ar-guide-combine.mp3",
      "text": "اِضْغَطْ عَلَى صُوَرِ الْمَجْمُوعَتَيْنِ لِتَضُمَّهَا فِي سَلَّةٍ وَاحِدَةٍ.",
