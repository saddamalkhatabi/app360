    {
      "path": "audio/en-guide-library.mp3",
      "text": "Choose an activity and play. Each time brings a new order and different pictures.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-count.mp3",
      "text": "Tap the picture to put a card in the basket.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-share.mp3",
      "text": "Choose a basket, then tap the picture. Share all the cards equally.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-combine.mp3",
      "text": "Tap the pictures in the two groups to join them in one basket.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-compare.mp3",
      "text": "Which row has more cards? Quantity matters, not the spacing.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-pattern.mp3",
      "text": "Look at the order of the pictures. Choose the next picture.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-review.mp3",
      "text": "Tell how you solved the order. Save or print it, then swap roles.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-match.mp3",
      "text": "The cards match the order. Tell how you did it.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-retry.mp3",
      "text": "Let us check again. Match the cards to the order, or ask for a hint.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-pause.mp3",
      "text": "Your place is kept when storage is available. Take your time and return when ready.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-role.mp3",
      "text": "I am the seller now. I make a clear order and check it with my grown-up.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-safety.mp3",
      "text": "Use cards or large safe pieces with your grown-up. Real food is not needed.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-fill.mp3",
      "text": "Complete the basket until it matches the order card.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-return.mp3",
      "text": "Tap a card in the basket to return the extras.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-split.mp3",
      "text": "Choose a basket, then add a card. Make two groups in your own way.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-mixed.mp3",
      "text": "Count the cards of each picture and match them to the order.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-measure.mp3",
      "text": "Put equal cards along the line with no gaps or overlaps.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-order.mp3",
      "text": "The order",
      "language": "en"
    },
    {
      "path": "audio/en-guide-total.mp3",
      "text": "Number of cards",
      "language": "en"
    },
    {
      "path": "audio/en-guide-baskets.mp3",
      "text": "Number of baskets",
      "language": "en"
    },
    {
      "path": "audio/en-guide-picture.mp3",
      "text": "The picture",
      "language": "en"
    },
    {
      "path": "audio/en-guide-demo.mp3",
      "text": "This is an example of how to play. Your own order is waiting.",
      "language": "en"
    },
    {
      "path": "audio/en-guide-coach.mp3",
      "text": "Choose an activity, pictures and a number range. We make a different order each time.",
      "language": "en"
