  "items": [
    {
      "path": "audio/ar-little-order-title.mp3",
      "text": "سَلَّةُ التُّفَّاحِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "4995418f628356d92006508bd3f33750c870f0b6f8d9a508b78e3fdc03666a06"
    },
    {
      "path": "audio/ar-little-order-prompt.mp3",
      "text": "ضَعْ ٣ بَطَاقَاتِ تُفَّاحٍ فِي السَّلَّةِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "4eed84298a9a7cff14f0f69c84df76c118da165813c2d6f9168f62e8f58d23c1"
    },
    {
      "path": "audio/ar-little-order-hint.mp3",
      "text": "لِكُلِّ بَطَاقَةٍ مَكَانٌ. أَشِرْ إِلَيْهَا وَأَنْتَ تَعُدُّ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "c1e5d9c301b9fe144e07529c0358cc22bddb95f459170985392b5389550f3e09"
    },
    {
      "path": "audio/ar-little-order-real.mp3",
      "text": "اِصْنَعْ طَلَبًا صَغِيرًا بِبَطَاقَاتٍ وَرَقِيَّةٍ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "13dbf30fae7701ff2ff9f560ea7ea68a8d147afb03d2e3507b90b53343f4480b"
    },
    {
      "path": "audio/en-little-order-title.mp3",
      "text": "An apple order",
      "language": "en"
    },
    {
      "path": "audio/en-little-order-prompt.mp3",
      "text": "Put 3 apple cards in the basket.",
      "language": "en"
    },
    {
      "path": "audio/en-little-order-hint.mp3",
      "text": "Touch each card once as you count. Try the spaces in the frame.",
      "language": "en"
    },
    {
      "path": "audio/en-little-order-real.mp3",
      "text": "Make a small order using paper cards.",
      "language": "en"
    },
    {
      "path": "audio/ar-cups-for-friends-title.mp3",
      "text": "كُوبٌ لِكُلِّ صَدِيقٍ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "95c3644950e278a90e565d066264690f6007c2ccf27e63e315910dd1a458ba3c"
    },
    {
      "path": "audio/ar-cups-for-friends-prompt.mp3",
      "text": "وَزِّعْ ٤ بَطَاقَاتِ أَكْوَابٍ عَلَى سَلَّتَيْنِ بِالتَّسَاوِي.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "c6d69de315a920d8dd2bb2729d1b78f99f46574a2ad0aac79fc9e72a938a75f2"
    },
    {
      "path": "audio/ar-cups-for-friends-hint.mp3",
      "text": "ضَعْ بَطَاقَةً هُنَا، ثُمَّ بَطَاقَةً هُنَاكَ. هَلْ تَتَقَابَلُ الْبَطَاقَاتُ؟",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "84a8b3ac53c398b64f0895320461582171cfe824b78135131f494163b7d8b085"
    },
    {
      "path": "audio/ar-cups-for-friends-real.mp3",
      "text": "رَتِّبْ بَطَاقَاتِ أَكْوَابٍ لِشَخْصَيْنِ عَلَى الطَّاوِلَةِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "37d1b6965b035b30228f47d555ef74f2bead27ea9b788536b18b15e3e9f60879"
    },
    {
      "path": "audio/en-cups-for-friends-title.mp3",
      "text": "Cups for friends",
      "language": "en"
    },
    {
      "path": "audio/en-cups-for-friends-prompt.mp3",
      "text": "Share 4 cup cards equally between 2 baskets.",
      "language": "en"
    },
    {
      "path": "audio/en-cups-for-friends-hint.mp3",
      "text": "Give one card here, then one there. Match the cards in pairs.",
      "language": "en"
    },
    {
      "path": "audio/en-cups-for-friends-real.mp3",
      "text": "Set out paper cup cards for two people at a table.",
      "language": "en"
    },
    {
      "path": "audio/ar-more-or-longer-title.mp3",
      "text": "أَكْثَرُ أَمْ أَطْوَلُ؟",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "7e4885b3cc64d7c1973f40b2a4b3e924aba997fd3b112e954f8515e0eb371347"
    },
    {
      "path": "audio/ar-more-or-longer-prompt.mp3",
      "text": "أَيُّ صَفٍّ فِيهِ بَطَاقَاتٌ أَكْثَرُ؟ لَا تَعْتَمِدْ عَلَى طُولِهِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "7d1f1ce408036bdaeda1ab443b716f16dcb0f19e2dc3d48b53502c62f1bf4af2"
    },
    {
      "path": "audio/ar-more-or-longer-hint.mp3",
      "text": "جَرِّبْ عَرْضَ بَطَاقَةٍ مُقَابِلَ بَطَاقَةٍ. هَلْ تَبْقَى بَطَاقَةٌ؟",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "590c18ef8e7221dcb6fa436436a4a5e44834077732139b341627fa404bdef5ad"
    },
    {
      "path": "audio/ar-more-or-longer-real.mp3",
      "text": "قَارِنْ صَفَّيْنِ مِنْ بَطَاقَاتِ الْوَرَقِ، ثُمَّ بَاعِدْ بَيْنَهُمَا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "5759809e85b9b2f2c89c6edc3e41487a5e07801926652e7d242f4bf20a04a5e5"
    },
    {
      "path": "audio/en-more-or-longer-title.mp3",
      "text": "More or longer?",
      "language": "en"
    },
    {
      "path": "audio/en-more-or-longer-prompt.mp3",
      "text": "Which row has more cards? A longer row may have fewer cards.",
      "language": "en"
    },
    {
      "path": "audio/en-more-or-longer-hint.mp3",
      "text": "Match one card from each row. Is a card left over?",
      "language": "en"
    },
    {
      "path": "audio/en-more-or-longer-real.mp3",
      "text": "Compare two rows of paper cards, then change the spaces between them.",
      "language": "en"
    },
    {
      "path": "audio/ar-small-pattern-title.mp3",
      "text": "رَفٌّ مُتَنَاوِبٌ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "979e4defff0162bae900daf1187e2733fd7a8f417c9af626c2a1a3b506b61907"
    },
    {
      "path": "audio/ar-small-pattern-prompt.mp3",
      "text": "أَكْمِلْ نَمَطَ الرَّفِ. تَابِعْ نَفْسَ التَّرْتِيبِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "72733ae43752031ee39d26483fdab8a343c3aeb530eb3602b46e65971c365034"
    },
    {
      "path": "audio/ar-small-pattern-hint.mp3",
      "text": "اِسْمَعْ أَسْمَاءَ الْبَطَاقَاتِ الْمَوْجُودَةِ، ثُمَّ جَرِّبْ تَكْرَارَهَا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "c7551093432300e17adcb89c495652515659f6dc078ffae150e487dd0e64ce29"
    },
    {
      "path": "audio/ar-small-pattern-real.mp3",
      "text": "اِصْنَعْ نَمَطًا بِبَطَاقَتَيْنِ مُخْتَلِفَتَيْنِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "3112108adcb55ad4ffe9c19d66eeefe5f61dbdff262f29dfb1f252c500c4d202"
    },
    {
      "path": "audio/en-small-pattern-title.mp3",
      "text": "A repeating shelf",
      "language": "en"
    },
    {
      "path": "audio/en-small-pattern-prompt.mp3",
      "text": "Continue the shelf pattern. Keep the same order.",
      "language": "en"
    },
    {
      "path": "audio/en-small-pattern-hint.mp3",
      "text": "Say the names of the cards already there. Try repeating that order.",
      "language": "en"
    },
    {
      "path": "audio/en-small-pattern-real.mp3",
      "text": "Make a pattern with two different kinds of paper cards.",
      "language": "en"
    },
    {
      "path": "audio/ar-missing-order-title.mp3",
      "text": "طَلَبٌ نَاقِصٌ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "463cdbc20fd6594710511dc2c34c737c1c7dcdd33d206ed56da26ec3ded41f45"
    },
    {
      "path": "audio/ar-missing-order-prompt.mp3",
      "text": "الطَّلَبُ ٥ بَطَاقَاتِ جَزَرٍ. فِي السَّلَّةِ ٣. أَكْمِلِ الطَّلَبَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "3b8a325bd0175a8b0fa5e3e6a1034dfec922d63ca3a729aef25a1a9f36eed2f3"
    },
    {
      "path": "audio/ar-missing-order-hint.mp3",
      "text": "عُدَّ مَا فِي السَّلَّةِ، ثُمَّ اِمْلَأِ الْأَمَاكِنَ الْفَارِغَةَ حَتَّى يَكْتَمِلَ الطَّلَبُ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "b3600e4e36e9f55e52b94d7a4d9626504dfeed483f5083252f4fe53480b440e1"
    },
    {
      "path": "audio/ar-missing-order-real.mp3",
      "text": "أَخْفِ بَعْضَ بَطَاقَاتِ طَلَبٍ، وَدَعِ الْمَرَافِقَ يُكْمِلُهُ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "c3262a2e2f9070fe44b248e632601d9dfa0b71b2b5f555f857fb4d21b246c2b7"
    },
    {
      "path": "audio/en-missing-order-title.mp3",
      "text": "A missing order",
      "language": "en"
    },
    {
      "path": "audio/en-missing-order-prompt.mp3",
      "text": "The order needs 5 carrot cards. The basket has 3. Complete it.",
      "language": "en"
    },
    {
      "path": "audio/en-missing-order-hint.mp3",
      "text": "Count the cards you have. Fill spaces until the order is complete.",
      "language": "en"
    },
    {
      "path": "audio/en-missing-order-real.mp3",
      "text": "Hide some cards from an order and let your grown-up complete it.",
      "language": "en"
    },
    {
      "path": "audio/ar-two-ways-title.mp3",
      "text": "الْعَدَدُ بِطَرِيقَتَيْنِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "251a412c4f991cb12a3dea3abd312d7e959df9f595db2287e4e2e302816c4104"
    },
    {
      "path": "audio/ar-two-ways-prompt.mp3",
      "text": "قَسِّمْ ٨ بَطَاقَاتٍ بَيْنَ سَلَّتَيْنِ. ضَعْ بَطَاقَاتٍ فِي كِلْتَيْهِمَا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "ee3cd2eddfb5ed616282047fb79857ed862c75436a1aed87a86c6bd2b948179c"
    },
    {
      "path": "audio/ar-two-ways-hint.mp3",
      "text": "غَيِّرْ تَقْسِيمَ السَّلَّتَيْنِ. هَلْ تَغَيَّرَ الْمَجْمُوعُ؟",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "222b74c9631a688f94c8dda88b3852e93fe46fe47b88e68a75a57989fdbc7e88"
    },
    {
      "path": "audio/ar-two-ways-real.mp3",
      "text": "رَتِّبْ نَفْسَ الْبَطَاقَاتِ فِي مَجْمُوعَتَيْنِ، ثُمَّ غَيِّرْ تَقْسِيمَهَا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "474cdcf7ad04d6c3c9591be93553fa3636717f9c074085990af382eed6f75bd3"
    },
    {
      "path": "audio/en-two-ways-title.mp3",
      "text": "One number, two ways",
      "language": "en"
    },
    {
      "path": "audio/en-two-ways-prompt.mp3",
      "text": "Split 8 cards between 2 baskets. Put cards in both baskets.",
      "language": "en"
    },
    {
      "path": "audio/en-two-ways-hint.mp3",
      "text": "Try another split. Did the total number change?",
      "language": "en"
    },
    {
      "path": "audio/en-two-ways-real.mp3",
      "text": "Split the same paper cards into two groups, then change the split.",
      "language": "en"
    },
    {
      "path": "audio/ar-two-friends-title.mp3",
      "text": "سَلَّةٌ لِصَدِيقَيْنِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "6225a32576c7ca4933ee11391a74ca19563bb913d8323a245839a7ce49c43ab9"
    },
    {
      "path": "audio/ar-two-friends-prompt.mp3",
      "text": "وَزِّعْ ٦ بَطَاقَاتِ فَرَاوْلَةٍ بِالتَّسَاوِي بَيْنَ سَلَّتَيْنِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "fd60428149e42ec3f2c9da722c2f0886df331e0559ab8ddf22a632c58a376ec8"
    },
    {
      "path": "audio/ar-two-friends-hint.mp3",
      "text": "وَزِّعْ بِالدَّوْرِ، ثُمَّ قَابِلْ كُلَّ بَطَاقَةٍ بِبَطَاقَةٍ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "685d40f3efb24444676547e9c643c9ad2da6758e988713ed17c2620ad3578e7c"
    },
    {
      "path": "audio/ar-two-friends-real.mp3",
      "text": "اِسْتَخْدِمْ بَطَاقَاتٍ كَبِيرَةً لِتَقْسِيمِ طَلَبٍ بَيْنَ صَدِيقَيْنِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "f2b37d1654ed0f9af4d793300aa712cc8726ca802b48774f90955c680d7dc202"
    },
    {
      "path": "audio/en-two-friends-title.mp3",
      "text": "Baskets for two friends",
      "language": "en"
    },
    {
      "path": "audio/en-two-friends-prompt.mp3",
      "text": "Share 6 strawberry cards equally between 2 baskets.",
      "language": "en"
    },
    {
      "path": "audio/en-two-friends-hint.mp3",
      "text": "Take turns adding one card to each basket. Match the groups.",
      "language": "en"
    },
    {
      "path": "audio/en-two-friends-real.mp3",
      "text": "Use large paper cards to share an order between two friends.",
      "language": "en"
    },
    {
      "path": "audio/ar-shelf-pattern-title.mp3",
      "text": "نَمَطُ الرَّفِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "2a59844abffdcb9c6bdc6e9e7a02e2b438f3fc89d7b44aa65ca70435f6ddf3f7"
    },
    {
      "path": "audio/ar-shelf-pattern-prompt.mp3",
      "text": "أَكْمِلْ نَمَطَ الرَّفِ، ثُمَّ اِحْكِ الْقَاعِدَةَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "51562ca4e0200bfe565eceee1258c16e0c2a25d88acbd9c5eba161cd387e78e1"
    },
    {
      "path": "audio/ar-shelf-pattern-hint.mp3",
      "text": "اِبْحَثْ عَنِ الْجُزْءِ الَّذِي يَتَكَرَّرُ. اِبْدَأْ مِنْ أَوَّلِ الرَّفِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "8fa3e22ed726c394765410ba2b959668902f93551201115bef37eb84ce6efb1c"
    },
    {
      "path": "audio/ar-shelf-pattern-real.mp3",
      "text": "اِخْتَرْ صُوَرًا جَدِيدَةً وَطَبِّقْ نَفْسَ الْقَاعِدَةِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "36b2e2363c5f6e68faab889203a660f6bb4a3016fb355b6025d8f8120842b8a0"
    },
    {
      "path": "audio/en-shelf-pattern-title.mp3",
      "text": "The shelf rule",
      "language": "en"
    },
    {
      "path": "audio/en-shelf-pattern-prompt.mp3",
      "text": "Complete the shelf pattern, then tell its rule.",
      "language": "en"
    },
    {
      "path": "audio/en-shelf-pattern-hint.mp3",
      "text": "Find the part that repeats. Start from the beginning of the shelf.",
      "language": "en"
    },
    {
      "path": "audio/en-shelf-pattern-real.mp3",
      "text": "Choose new pictures and use the same repeating rule.",
      "language": "en"
    },
    {
      "path": "audio/ar-join-order-title.mp3",
      "text": "نَجْمَعُ الطَّلَبَ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "546fa493ce170d6e1237f575f5fbc71d3579d48c1af3131b0e20b408fedf6cc5"
    },
    {
      "path": "audio/ar-join-order-prompt.mp3",
      "text": "اِنْقُلْ بَطَاقَاتِ السَّلَّتَيْنِ إِلَى سَلَّةِ الطَّلَبِ. كَمْ بَطَاقَةً أَصْبَحَ لَدَيْكَ؟",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "2f2d993b935300eace29d1f0989b5db1b6ce9c1fff24741a190ad3c228fbd79b"
    },
    {
      "path": "audio/ar-join-order-hint.mp3",
      "text": "اِنْقُلْ كُلَّ بَطَاقَةٍ مَرَّةً وَاحِدَةً، ثُمَّ عُدَّ السَّلَّةَ الْجَدِيدَةَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "da010c55bbfa5941beb2117de075fddcc019927086f0c7db12f09e7055de0085"
    },
    {
      "path": "audio/ar-join-order-real.mp3",
      "text": "اِجْمَعْ مَجْمُوعَتَيْنِ مِنْ بَطَاقَاتٍ كَبِيرَةٍ فِي طَلَبٍ وَاحِدٍ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "8c46bef3e1ff94cf1bd789bdebb4eb0e5b46d6528c78704440cd926cfefb3145"
    },
    {
      "path": "audio/en-join-order-title.mp3",
      "text": "Join the order",
      "language": "en"
    },
    {
      "path": "audio/en-join-order-prompt.mp3",
      "text": "Move both groups into the order basket. How many cards do you have now?",
      "language": "en"
    },
    {
      "path": "audio/en-join-order-hint.mp3",
