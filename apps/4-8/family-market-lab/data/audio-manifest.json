      "engine": "silma-tts-1.0.5",
      "sha256": "405081422aa3238773db326ab4dcaad6a3f122798c3f625243c0ed19f1f610e2"
    },
    {
      "path": "audio/ar-guide-match.mp3",
      "text": "عَدَدُ الْبَطَاقَاتِ يَطَابِقُ الطَّلَبَ. اِحْكِ طَرِيقَتَكَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "fd0c276a3e0b6e9d401b4e5de7b5b8ca9dd0ef87bd8dfe144559478aebeed7a8"
    },
    {
      "path": "audio/ar-guide-retry.mp3",
      "text": "لِنُعِدِ الْفَحْصَ بِهُدُوءٍ. قَارِنِ الْبَطَاقَاتِ بِالطَّلَبِ، أَوِ اِطْلُبْ تَلْمِيحًا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "b771a46db6422282bc51e34d953d46cba6b06b0888754e5b6427e1e5232cc225"
    },
    {
      "path": "audio/ar-guide-pause.mp3",
      "text": "حَفِظْنَا مَكَانَكَ إِنْ كَانَ الْحَفْظُ مُتَاحًا. خُذْ وَقْتَكَ وَعُدْ عِنْدَمَا تَكُونُ مُسْتَعِدًّا.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "6dfb1d49cc2c7850bb3e86d70af380d1862ebbef78acd910c7b69d0821420e61"
    },
    {
      "path": "audio/ar-guide-role.mp3",
      "text": "أَنَا الْبَائِعُ الْآنَ. أَصْنَعُ طَلَبًا وَاضِحًا وَأَفْحَصُهُ مَعَ الْمَرَافِقِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "ed2dd443e3bd861ae6817eb6a00da69c5d6d3c4f72e99198d4a6d60bae4883d9"
    },
    {
      "path": "audio/ar-guide-safety.mp3",
      "text": "اِسْتَخْدِمْ بَطَاقَاتٍ أَوْ قِطَعًا كَبِيرَةً آمِنَةً مَعَ الْمَرَافِقِ. لَا يَلْزَمُ طَعَامٌ حَقِيقِيٌّ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "7c5e875378109c264d687dfc15e593cd5e1e5abdb75bf728db1412f5c6234bb8"
    },
    {
      "path": "audio/ar-guide-fill.mp3",
      "text": "أَكْمِلِ السَّلَّةَ حَتَّى تُطَابِقَ بَطَاقَةَ الطَّلَبِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "c18548c5748032b33b3fa5c6c6d01ee0d0c0dfee00517d3c2802da812495a325"
    },
    {
      "path": "audio/ar-guide-return.mp3",
      "text": "اِضْغَطْ عَلَى بَطَاقَةٍ فِي السَّلَّةِ لِإِعَادَةِ الزَّائِدِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "1a88d33d92ef3b8151dd97833c02ce07e7119d48604e431204781cf922c7aaff"
    },
    {
      "path": "audio/ar-guide-split.mp3",
      "text": "اِخْتَرْ سَلَّةً، ثُمَّ ضَعْ بَطَاقَةً. اصْنَعْ مَجْمُوعَتَيْنِ بِطَرِيقَتِكَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "6b4ef64caad853916e4dac81c0a971b4d5bb7990ea7893b39b9677d7070e045a"
    },
    {
      "path": "audio/ar-guide-mixed.mp3",
      "text": "عُدَّ بَطَاقَاتِ كُلِّ صُورَةٍ وَطَابِقْهَا بِالطَّلَبِ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "4dbaa125b931a0fb7c14389060749709d3f6d29442a35563df34aa997f7a3de5"
    },
    {
      "path": "audio/ar-guide-measure.mp3",
      "text": "ضَعِ الْبَطَاقَاتِ الْمُتَسَاوِيَةَ عَلَى الْخَطِّ دُونَ فَرَاغٍ أَوْ تَدَاخُلٍ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "eb7d013ee8134ccc3623ab4608dc420bcc41d9bca39f488941d97c207178d6bf"
    },
    {
      "path": "audio/ar-guide-order.mp3",
      "text": "الْمَطْلُوبُ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "05608bb974d7de4ed9e00688212050209fd5c36c39964b7a91c0b8337eb7135e"
    },
    {
      "path": "audio/ar-guide-total.mp3",
      "text": "عَدَدُ الْبَطَاقَاتِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "ba9dddc92f19d985484231ee1f2cdd4079b3d0bb81850540a371a12b2ae0dc60"
    },
    {
      "path": "audio/ar-guide-baskets.mp3",
      "text": "عَدَدُ السَّلَالِ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "edb2eef06787e63ecf1009008866d93dff6bba93f8404fdd9bc596c36e4b0848"
    },
    {
      "path": "audio/ar-guide-picture.mp3",
      "text": "الصُّورَةُ",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "60746e1241400413cee0581e944d0773dea4389380f52e81672f9c2d55ef0ca7"
    },
    {
      "path": "audio/ar-guide-demo.mp3",
      "text": "هَذَا مِثَالٌ لِلطَّرِيقَةِ. طَلَبُكَ الْأَصْلِيُّ يَنْتَظِرُكَ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "420f772070c48c83261f28aeef83883ada714c38323089fb0666b02a976d6e72"
    },
    {
      "path": "audio/ar-guide-coach.mp3",
      "text": "اِخْتَرْ نَمَطًا وَصُوَرًا وَمَدَى الْعَدَدِ. نُجَهِّزُ طَلَبًا مُخْتَلِفًا كُلَّ مَرَّةٍ.",
      "language": "ar",
      "engine": "silma-tts-1.0.5",
      "sha256": "103e39b3dcc671a309aa43eee0f99dbe7920b9432cc1299c08347110aba9451d"
    },
