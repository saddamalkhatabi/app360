    },
    {
      "id": "window",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-window.mp3",
      "text": "كَوِّنْ مُرَبَّعًا مِنْ مُثَلَّثَيْنِ. دَوِّرْ قِطْعَةً لِتَمْلَأَ النِّصْفَ الآخَرَ.",
      "sha256": "5660e68a8b30d080f7ccf7651e7a102a3013a187acc94a4586678ef9c5bb4712",
      "duration_ms": 5634,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "roof",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-roof.mp3",
      "text": "اِمْلَأْ شَكْلَ الكُوخِ بِثَلَاثِ قِطَعٍ. دَوِّرِ المُثَلَّثَيْنِ لِيُكَوِّنَا السَّقْفَ.",
      "sha256": "09e0da4476becd2e2865f6f7aa0c509bed22b9d85b41c92999fcdc267036ab5a",
      "duration_ms": 5685,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "stairs",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-stairs.mp3",
      "text": "اِمْلَأْ شَكْلَ الدَّرَجِ. جَرِّبْ تَدْوِيرَ المُسْتَطِيلَاتِ حَتَّى تَخْتَفِيَ الفَجَوَاتُ.",
      "sha256": "4a14a5a326fa778fcd09bf419c69e4cf7ebae90be319cc991c98a38fade90be0",
      "duration_ms": 5871,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "right",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-right.mp3",
      "text": "اِجْمَعْ قِطْعَتَيْنِ لِتَمْلَأَ فَتْحَةَ زَاوِيَةٍ قَائِمَةٍ قِيَاسُهَا تِسْعُونَ دَرَجَةً.",
      "sha256": "8d243ad82b15ffff22ed3deabf5fe313d4355483644a9c4691d67a4ce45346bc",
      "duration_ms": 5962,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "acute",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-acute.mp3",
      "text": "اِمْلَأْ فَتْحَةَ سِتِّينَ دَرَجَةً بِقِطْعَتَيْنِ مِنَ الدُّرْجِ.",
      "sha256": "88c3765c0bd58ba96b3b1655ae2e1b4c8df62dcb0b327c5b8e74e43ac105d6b9",
      "duration_ms": 4052,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "obtuse",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-obtuse.mp3",
      "text": "اِمْلَأْ زَاوِيَةَ مِائَةٍ وَعِشْرِينَ دَرَجَةً بِقِطْعَتَيْنِ مُتَجَاوِرَتَيْنِ.",
      "sha256": "6ea44726cf26d442ab6f7b32872ec79de7a7bc6dc0b5d696223ef2ee68d4b3b4",
      "duration_ms": 5126,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "straight",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-straight.mp3",
      "text": "اِبْنِ زَاوِيَةً مُسْتَقِيمَةً مِنْ ثَلَاثِ قِطَعٍ. مَا مَجْمُوعُ قِيَاسَاتِهَا؟",
      "sha256": "1fe80c4844303f59cd7070064df7dae3553f2e79c0d12266187d1655984b02c7",
      "duration_ms": 5302,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "diagonal",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-diagonal.mp3",
      "text": "حَرِّكْ دَلِيلَ القَصِّ حَتَّى يَصِلَ إِلَى الرُّكْنِ المُقَابِلِ. قُصَّ البَلَاطَةَ ثُمَّ اِمْلَأِ الفَرَاغَ.",
      "sha256": "931d1e05b751ea163a3ad61078b47fb89b9b1b6dfa97060a6c6b466d06e30b59",
      "duration_ms": 7165,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "shallow",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-shallow.mp3",
      "text": "اُنْظُرْ إِلَى الحَافَّةِ المَائِلَةِ. اِخْتَرِ الدَّلِيلَ الَّذِي يُوَازِيهَا ثُمَّ قُصَّ القِطْعَةَ.",
      "sha256": "7d840944f849df1261e7d0ba2661ca1f17576707254a167daecff6ccf7780a06",
      "duration_ms": 6746,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "steep",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-steep.mp3",
      "text": "قُصَّ بَلَاطَةً تُنَاسِبُ هَذِهِ الحَافَّةَ ثُمَّ جَرِّبِ القِطْعَةَ عَلَى اللَّوْحَةِ.",
      "sha256": "8bc8fe36f898a2f25dda654effeccc834787f1b6ddb68df2755757d3d2cf6ee7",
      "duration_ms": 5627,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "two-bays",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-two-bays.mp3",
      "text": "قُصَّ بَلَاطَةً وَاحِدَةً وَاسْتَعْمِلْ جُزْأَيْهَا لِسَدِّ الرُّكْنَيْنِ المُتَبَاعِدَيْنِ.",
      "sha256": "b1e12b85de60c4a1f1a09b074bd5b3ec9789d334b4f697d086da15a49dcf2877",
      "duration_ms": 5901,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "entry",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-entry.mp3",
      "text": "رُصَّ البَلَاطَاتِ الكَامِلَةَ فِي المَدْخَلِ. ثُمَّ قُصَّ قِطْعَةً تَمْلَأُ الحَافَّةَ المَائِلَةَ.",
      "sha256": "9ff6c60555791d55acf948ee1b897cccc09aa396e209c385cdc8cea25d7a6ba0",
      "duration_ms": 6591,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "terrace",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-terrace.mp3",
      "text": "أَكْمِلِ الشُّرْفَةَ بِالبَلَاطَاتِ الكَامِلَةِ، ثُمَّ اسْتَعْمِلْ جُزْأَيْ بَلَاطَةٍ وَاحِدَةٍ فِي الرُّكْنَيْنِ.",
      "sha256": "23d789107a25470d88fa64c29583dbdf7f30301f2e2997acf36f027ef52de41b",
      "duration_ms": 7288,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "column",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-column.mp3",
      "text": "غَطِّ الأَرْضَ حَوْلَ العَمُودِ. اُتْرُكِ المُرَبَّعَ المُظَلَّلَ فِي الوَسَطِ فَارِغًا، وَاسْتَعْمِلْ نِصْفَيِ القَصِّ.",
      "sha256": "6f0ce1586deac8bf647bcac922d9e1de8a798fccec89e164a88e0e93095c45b7",
      "duration_ms": 7954,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "final",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-final.mp3",
      "text": "أَكْمِلْ أَرْضِيَّةَ المَعْرِضِ. قِسْ مَيْلَ الرُّكْنِ، قُصَّ بَلَاطَةً وَاحِدَةً، وَاسْتَخْدِمِ الجُزْأَيْنِ بِلَا فَرَاغٍ أَوْ تَدَاخُلٍ.",
      "sha256": "40ed4f5f6d6b8c143a9c7d72263758dff93f7b0c5565eacdaed332caa7f203ca",
      "duration_ms": 9751,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-overlap",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-overlap.mp3",
      "text": "هُنَاكَ قِطْعَتَانِ فَوْقَ بَعْضِهِمَا. أَبْعِدْ إِحْدَاهُمَا حَتَّى تَلْتَقِيَ الحَافَّتَانِ.",
      "sha256": "5dcea2b5aa026eb1a491baba0f1bc57250f9e73afc726b20c485b64f53907c6a",
      "duration_ms": 6192,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-outside",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-outside.mp3",
      "text": "تَجَاوَزَتْ قِطْعَةٌ حُدُودَ الشَّكْلِ. حَرِّكْهَا إِلَى الدَّاخِلِ أَوْ جَرِّبْ تَدْوِيرَهَا.",
      "sha256": "d607875dd7a9853a3a88f63f657e27549bf04a2e0e143a0309d21e463f8c6e60",
      "duration_ms": 6050,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-gap",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-gap.mp3",
      "text": "بَقِيَ فَرَاغٌ. قَارِنْ حَوَافَّ القِطَعِ بِحُدُودِ المِسَاحَةِ الزَّرْقَاءِ.",
      "sha256": "e3332c6cb932200b65d6fb06a77f8dfba182b5df8c9d5628461e50b90d3f6ee7",
      "duration_ms": 5094,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-angle",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-angle.mp3",
      "text": "قَارِنْ بَيْنَ فَتْحَةِ الزَّاوِيَةِ وَحَوَافِّ القِطَعِ. دَوِّرْ قِطْعَةً وَرَاقِبْ مَكَانَ الحَافَّةِ.",
      "sha256": "5acdcdc69e62557c8773ce95945fe4ba0fa79c4591080695466d36b14bc6098e",
      "duration_ms": 6979,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-cut",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-cut.mp3",
      "text": "قَارِنْ مَيْلَ الحَافَّةِ المَتَبَقِّيَةِ بِخَطِّ القَصِّ، ثُمَّ جَرِّبْ مَيْلًا آخَرَ.",
      "sha256": "67e06a56754fe8f2523607e6e6177109b7fabe03b0d37b25c2acaa5608db677b",
      "duration_ms": 5655,
      "model_revision": "226dd7a65cadf51f9a6dbe3953fc89003b3844d5",
      "source": "SILMA TTS 1.0.5, public Arabic reference"
    },
    {
      "id": "coach-done",
      "language": "ar",
      "engine": "silma",
      "path": "audio/workshop/ar-coach-done.mp3",
      "text": "أَحْسَنْتَ! اِكْتَمَلَ البِنَاءُ. عِنْدَمَا تَكُونُ جَاهِزًا، اِنْتَقِلْ إِلَى المَهَمَّةِ التَّالِيَةِ.",
      "sha256": "fcedda2f69605baa41af254dea63290c34e2f55d50707d4b4295d25b5ff5f93b",
      "duration_ms": 7001,
