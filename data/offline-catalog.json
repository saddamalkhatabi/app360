    {
      "id": "1-4",
      "label_ar": "من 1 إلى 4 سنوات",
      "icon": "🧸",
      "focus_ar": "لغة مبكرة وحركة ولعب مشترك ومشاعر وروتين واستقلالية ومحاولات أولى، عبر تطبيقات تنتقل بالطفل والمرافق بين الشاشة والواقع بصورة آمنة ومتدرجة."
    },
    {
      "id": "4-8",
      "label_ar": "من 4 إلى 8 سنوات",
      "icon": "🌱",
      "focus_ar": "من التسمية والتقليد إلى القراءة والتعبير والتفسير؛ ومن الفرز والتركيب إلى العدد والتصميم والتجربة، مع استقلال متدرج ولعب مشترك ومسارات للمدرب. الفئة إطار عرض، ومستوى المهمة حسب الاستعداد."
    },
    {
      "id": "8-12",
      "label_ar": "من 8 إلى 12 سنة",
      "icon": "🧩",
      "focus_ar": "فهم واستدلال، STEM وبرمجة، مواطنة رقمية، مسؤولية وعادات صحية."
    },
    {
      "id": "12-16",
      "label_ar": "من 12 إلى 16 سنة",
      "icon": "🚀",
      "focus_ar": "دراسة ذاتية، تحقق من المعلومات، مرونة نفسية، تواصل، مشروعات ومال."
    },
    {
      "id": "16-24",
      "label_ar": "من 16 إلى 24 سنة",
      "icon": "🧭",
      "focus_ar": "تعلم عميق، AI، مهنة، دخل أول، تواصل، ريادة ومشروعات حقيقية."
    },
    {
      "id": "24-45",
      "label_ar": "من 24 إلى 45 سنة",
      "icon": "⚙️",
      "focus_ar": "إنتاجية وقرارات وقيادة ومال وأسرة وصحة مستدامة وتدريب وAI."
    },
    {
      "id": "45-60",
      "label_ar": "من 45 إلى 60 سنة",
      "icon": "🌿",
      "focus_ar": "حركة وصحة وظيفية، ثقة رقمية، نقل خبرة، انتقال مهني، تخطيط ومعنى."
    },
    {
      "id": "60-80",
      "label_ar": "من 60 إلى 80 سنة",
      "icon": "🌟",
      "focus_ar": "تعلم مستمر، استقلال رقمي، حركة آمنة، تواصل، ذكريات واستقلال يومي."
    }
