NODE_ENV=production
APP360_PORT=3036
APP360_DB_FILE=./var/app360.sqlite3
APP360_ALLOWED_ORIGINS=https://school.yem1.com
APP360_ENABLE_SEED_LOGIN=0
# Reels origin only, not an /api URL. Use the actual deployed Reels host.
APP360_REELS_BASE_URL=https://yem1.com
# Match SCHOOL_BRIDGE_SECRET on Reels. Generate a random 32+ character secret.
APP360_REELS_BRIDGE_SECRET=
