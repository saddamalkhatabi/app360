NODE_ENV=production
APP360_PORT=3036
APP360_DB_FILE=./var/app360.sqlite3
APP360_ALLOWED_ORIGINS=https://school.yem1.com
APP360_ENABLE_SEED_LOGIN=0
# Reels origin only, not an /api URL. Use the actual deployed Reels host.
APP360_REELS_BASE_URL=https://yem1.com
# Match SCHOOL_BRIDGE_SECRET on Reels. Generate a random 32+ character secret.
APP360_REELS_BRIDGE_SECRET=

# Prepare first, then enable only after billing grants and listening review are ready.
APP360_ENABLE_PERSONALIZED_PRAISE=0
APP360_ENABLE_GOOGLE_NAME_TTS=0
APP360_GOOGLE_NAME_DAILY_LIMIT=10
# Service-account JSON, secret on the server only; never put credentials in HTML.
APP360_GOOGLE_TTS_CREDENTIALS_JSON=
